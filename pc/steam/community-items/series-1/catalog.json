  "cards": [
    {
      "id": "fox",
      "type": "card",
      "internal": "dicekin_card_fox",
      "source": "sources/card-fox.png",
      "title": {
        "english": "Sparkfox",
        "japanese": "ヒバナギツネ",
        "koreana": "불씨여우",
        "tchinese": "閃尾狐",
        "schinese": "闪尾狐"
      },
      "description": {
        "english": "A bright-eyed companion races toward the next adventure, with a lucky roll waiting on the trail.",
        "japanese": "幸運のひと振りを待ちながら、瞳を輝かせた仲間が次の冒険へ駆け出す。",
        "koreana": "반짝이는 눈의 동료가 다음 모험으로 달려간다. 길 위에는 행운의 주사위가 기다린다.",
        "tchinese": "眼中閃著光的夥伴奔向下一段冒險，幸運的一擲就在前方。",
        "schinese": "眼中闪着光的伙伴奔向下一段冒险，幸运的一掷就在前方。"
      },
      "sourcePixels": [
        1672,
        941
      ],
      "large": "cards/fox.jpg",
      "small": "cards/fox-small.png"
    },
    {
      "id": "bud",
      "type": "card",
      "internal": "dicekin_card_bud",
      "source": "sources/card-bud.png",
      "title": {
        "english": "Sproutling",
        "japanese": "メバエリュウ",
        "koreana": "새싹룡",
        "tchinese": "芽芽龍",
        "schinese": "芽芽龙"
      },
      "description": {
        "english": "Where the forest wakes, a little leaf-eared friend discovers that every roll can begin a new journey.",
        "japanese": "森が目覚める場所で、葉の耳を持つ小さな仲間が、新たな旅を告げるサイコロに出会う。",
        "koreana": "숲이 깨어나는 곳에서 잎사귀 귀를 가진 작은 친구가 새로운 여정을 열 주사위를 발견한다.",
        "tchinese": "森林甦醒之處，葉耳小夥伴發現，每一次擲骰都能開啟新的旅程。",
        "schinese": "森林苏醒之处，叶耳小伙伴发现，每一次掷骰都能开启新的旅程。"
      },
      "sourcePixels": [
        1672,
        941
      ],
      "large": "cards/bud.jpg",
      "small": "cards/bud-small.png"
    },
    {
      "id": "otter",
      "type": "card",
      "internal": "dicekin_card_otter",
      "source": "sources/card-otter.png",
      "title": {
        "english": "Bubbotter",
        "japanese": "アワカワウソ",
        "koreana": "물방울수달",
        "tchinese": "潮泡獺",
        "schinese": "潮泡獭"
      },
      "description": {
        "english": "A splash, a bubble, and a playful catch. Even a quiet stream has room for a little dice magic.",
        "japanese": "水しぶき、泡、そして見事なキャッチ。静かな小川にもサイコロの魔法がきらめく。",
        "koreana": "물보라와 물방울 사이로 장난스러운 한 번의 캐치. 고요한 시냇물에도 주사위의 마법이 깃든다.",
        "tchinese": "水花、泡泡與輕巧的一接，寧靜溪流也藏著骰子的魔法。",
        "schinese": "水花、泡泡与轻巧的一接，宁静溪流也藏着骰子的魔法。"
      },
      "sourcePixels": [
        1672,
        941
      ],
      "large": "cards/otter.jpg",
      "small": "cards/otter-small.png"
    },
    {
      "id": "owl",
      "type": "card",
      "internal": "dicekin_card_owl",
      "source": "sources/card-owl.png",
      "title": {
        "english": "Starowl",
        "japanese": "ホシワフクロウ",
        "koreana": "별고리올빼미",
        "tchinese": "星環鴞",
        "schinese": "星环鸮"
      },
      "description": {
        "english": "Beneath ancient stars, the ringed guardian watches over the possibilities of the next roll.",
        "japanese": "太古の星空の下、環をまとう守護者が、次のひと振りに秘められた可能性を見守る。",
        "koreana": "오랜 별들 아래에서 고리를 두른 수호자가 다음 주사위에 담긴 가능성을 지켜본다.",
        "tchinese": "古老星空下，星環守護者凝望下一擲所蘊藏的可能。",
        "schinese": "古老星空下，星环守护者凝望下一掷所蕴藏的可能。"
      },
      "sourcePixels": [
        1672,
        941
      ],
      "large": "cards/owl.jpg",
      "small": "cards/owl-small.png"
    },
    {
      "id": "dragon",
      "type": "card",
      "internal": "dicekin_card_dragon",
      "source": "sources/card-dragon.png",
      "title": {
        "english": "Thundrake",
        "japanese": "ライカンリュウ",
        "koreana": "뇌관룡",
        "tchinese": "霆冠龍",
        "schinese": "霆冠龙"
      },
      "description": {
        "english": "Above the storm, a thunder-crowned dragon greets the dawn. The boldest journeys begin with one roll.",
        "japanese": "嵐の上で、雷の冠をいただく竜が夜明けを迎える。勇敢な旅も、ひと振りから始まる。",
        "koreana": "폭풍 위에서 번개의 왕관을 쓴 용이 새벽을 맞는다. 대담한 여정도 주사위 한 번에서 시작된다.",
        "tchinese": "風暴之上，雷冠之龍迎接黎明。勇敢的旅程，始於一次擲骰。",
        "schinese": "风暴之上，雷冠之龙迎接黎明。勇敢的旅程，始于一次掷骰。"
      },
      "sourcePixels": [
        1672,
        941
      ],
      "large": "cards/dragon.jpg",
      "small": "cards/dragon-small.png"
    }
  ],
